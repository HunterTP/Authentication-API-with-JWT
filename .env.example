# ============================================
# Authentication Server configuration
# ============================================

# ----- Database -----
# NECESSARY: Root-Password for MySQL
DB_ROOT_PASSWORD=rootpass

# Optional (have Defaults)
DB_NAME=authdb
DB_USER=appuser
DB_PASSWORD=appuserpass
DB_PORT=3306

# ----- JWT -----
# NECESSARY: At least 32 characters!
JWT_SECRET=mySuperSecureJWTSecretThatIsAtLeast32CharactersLong

# Optional (1 hour default)
JWT_EXPIRATION_MS=3600000

# ----- BCrypt Pepper -----
# NECESSARY: Secret Pepper (not in the DB!)
BCRYPT_PEPPER=mySECRETPepperThatIsNotStoredInTheDB

# Optional (12 is good)
BCRYPT_WORKLOAD=15

# ----- Keystore (HTTPS) -----
# NECESSARY: Passwords for your certificate
# Default keystore (self-signed) is created in the Docker build with 123456
# For production, generate your own certificate and adjust here!
KEYSTORE_PASS=123456
KEY_PASS=123456

# Optional: Path to a custom keystore (override the built-in default)
# To do this, enable the volume mount in docker-compose.yml (commented-out line)
# KEYSTORE_PATH=./keystore.jks

# ----- Server -----
API_PORT=8443